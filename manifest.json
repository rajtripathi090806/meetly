
{
    "manifest_version": 3,
    "action": { "default_popup": "popup.html" },

    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    
    "name": "Meetly - Google Meet Attendance Exporter",
    "description": "Automatically exports Google Meet attendance data on leaving the meeting.",
    "version": "1.0.0",

    "permissions": [ "downloads", "storage" ],
    "host_permissions": [ "https://meet.google.com/*" ],

    "content_scripts": [
        {
            "matches": [ "https://meet.google.com/*" ],
            "run_at": "document_idle",

            "css": [
                "libs/bootstrap_5.css",
                "libs/notyf.css",
                "custom.css"
            ],

            "js": [
                "libs/notyf.js",
                "libs/xlsx.full.min.js",
                "src/utils.js",
                "src/exporter.js",
                "src/meeting-details.js",
                "src/attendance.js",
                "src/meeting-lifecycle.js",
                "main.js"
            ]
        }
    ]
}
